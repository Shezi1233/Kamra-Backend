# Kamora Tech FastAPI backend configuration
# PostgreSQL / Neon is the only supported production database.

# Preferred: full SQLAlchemy/PostgreSQL URL.
# Use the pooled Neon URL for the application and the direct URL for migrations.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Individual PostgreSQL settings (used when DATABASE_URL is empty).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=agency_db
DB_USER=postgres
DB_PASSWORD=

# Frontend origins allowed to call the API (comma separated).
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Public URL of this API.
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=

UPLOAD_STORAGE=local
UPLOAD_DIR=uploads
UPLOAD_MAX_BYTES=2097152

S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

DB_POOL_RECYCLE=280

# ---- Chatbot (isolated from the main website database) ----
# Neon Postgres used only for chat sessions, messages, feedback and ingestion logs.
CHATBOT_DATABASE_URL=postgresql://user:password@chatbot-host/dbname?sslmode=require

COHERE_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=kamora_site_knowledge
